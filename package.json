{
  "name": "rare-essence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-demo.ps1",
    "demo:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/demo-reset.ps1",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "admin:hash": "tsx scripts/hash-admin-password.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.1.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true
  }
}
