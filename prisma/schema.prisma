generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FamiliaOlfativa {
  CITRICO
  AMADEIRADO
  ESPECIADO
  ORIENTAL
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String
  slug     String    @unique
  produtos Produto[]
  criadoEm DateTime  @default(now()) @map("criado_em")

  @@map("categorias")
}

model Marca {
  id       String    @id @default(uuid())
  nome     String
  slug     String    @unique
  produtos Produto[]
  criadoEm DateTime  @default(now()) @map("criado_em")

  @@map("marcas")
}

model Produto {
  id           String   @id @default(uuid())
  nome         String
  slug         String   @unique
  descricao    String
  imagemUrl    String?  @map("imagem_url")
  marcaId      String   @map("marca_id")
  categoriaId  String   @map("categoria_id")
  familiaOlfativa FamiliaOlfativa @map("familia_olfativa")
  notasTopo    String[] @map("notas_topo")
  notasCoracao String[] @map("notas_coracao")
  notasBase    String[] @map("notas_base")
  ativo        Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  marca     Marca      @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  categoria Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  variacoes Variacao[]

  @@map("produtos")
}

model Variacao {
  id            String   @id @default(uuid())
  produtoId     String   @map("produto_id")
  sku           String   @unique
  volumeMl      Int      @map("volume_ml")
  precoCentavos Int      @map("preco_centavos")
  pesoGramas    Int      @default(250) @map("peso_gramas")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")

  produto Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  estoque EstoqueItem?

  @@map("variacoes")
}

model EstoqueItem {
  id                  String   @id @default(uuid())
  variacaoId          String   @unique @map("variacao_id")
  quantidadeFisica    Int      @default(0) @map("quantidade_fisica")
  quantidadeReservada Int      @default(0) @map("quantidade_reservada")
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  variacao Variacao @relation(fields: [variacaoId], references: [id], onDelete: Cascade)

  @@map("estoque_itens")
}

model Pedido {
  id                       String                   @id @default(uuid())
  codigoRastreavel         String                   @unique @map("codigo_rastreavel")
  status                   String                   @default("CRIADO")
  formaPagamento           String                   @map("forma_pagamento")
  clienteNome              String                   @map("cliente_nome")
  clienteEmail             String                   @map("cliente_email")
  clienteCpf               String                   @map("cliente_cpf")
  clienteTelefone          String                   @map("cliente_telefone")
  enderecoCep              String                   @map("endereco_cep")
  enderecoLogradouro       String                   @map("endereco_logradouro")
  enderecoNumero           String                   @map("endereco_numero")
  enderecoComplemento      String?                  @map("endereco_complemento")
  enderecoBairro           String                   @map("endereco_bairro")
  enderecoCidade           String                   @map("endereco_cidade")
  enderecoEstado           String                   @map("endereco_estado")
  subtotalProdutosCentavos Int                      @map("subtotal_produtos_centavos")
  descontoCupomCentavos    Int                      @map("desconto_cupom_centavos")
  descontoPixCentavos      Int                      @map("desconto_pix_centavos")
  codigoCupom              String?                  @map("codigo_cupom")
  freteModalidade          String                   @map("frete_modalidade")
  fretePrazoDias           Int                      @map("frete_prazo_dias")
  freteValorCentavos       Int                      @map("frete_valor_centavos")
  totalCartaoCentavos      Int                      @map("total_cartao_centavos")
  totalPixCentavos         Int                      @map("total_pix_centavos")
  totalEmCentavos          Int                      @map("total_em_centavos")
  expiraEm                 DateTime?                @map("expira_em")
  criadoEm                 DateTime                 @default(now()) @map("criado_em")
  atualizadoEm             DateTime                 @updatedAt @map("atualizado_em")
  itens                    PedidoItem[]
  eventosPagamento         EventoWebhookPagamento[]

  @@map("pedidos")
}

model PedidoItem {
  id                    String @id @default(uuid())
  pedidoId              String @map("pedido_id")
  variacaoId            String @map("variacao_id")
  sku                   String
  nomeProduto           String @map("nome_produto")
  volumeMl              Int    @map("volume_ml")
  quantidade            Int
  precoUnitarioCentavos Int    @map("preco_unitario_centavos")
  subtotalCentavos      Int    @map("subtotal_centavos")
  pedido                Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("pedido_itens")
}

model EventoWebhookPagamento {
  id                 String   @id @default(uuid())
  idEventoExterno    String   @unique @map("id_evento_externo")
  idPagamentoExterno String   @map("id_pagamento_externo")
  pedidoId           String   @map("pedido_id")
  acao               String
  statusPagamento    String   @map("status_pagamento")
  resultado          String
  recebidoEm         DateTime @map("recebido_em")
  pedido             Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@map("eventos_webhook_pagamento")
}

model RateLimitBucket {
  chave             String   @id
  inicioJanela      DateTime @map("inicio_janela")
  requisicoes       Int
  expiraEm          DateTime @map("expira_em")

  @@index([expiraEm])
  @@map("rate_limit_buckets")
}
