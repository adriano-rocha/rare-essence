# Banco de Dados (Neon Database ou PostgreSQL Local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rare_essence?schema=public"

# Autenticação do Administrador Único
ADMIN_EMAIL="admin@rareessence.com.br"
ADMIN_PASSWORD_HASH="$2b$10$exemploDeHashBcryptOuArgon2ParaTestes"
ADMIN_SESSION_SECRET="rare-essence-secret-super-seguro-min-32-chars"

# Gateway de Pagamento (Mercado Pago Sandbox)
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_WEBHOOK_SECRET="webhook_secret_sandbox"

# Gateway de Frete (Melhor Envio Sandbox)
MELHOR_ENVIO_TOKEN="bearer_token_sandbox"
MELHOR_ENVIO_SANDBOX="true"
CEP_ORIGEM="01001000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"