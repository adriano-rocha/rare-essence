# Banco de Dados (Neon Database ou PostgreSQL Local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rare_essence?schema=public"
# URL direta, sem pool (usada pelas migrations; no local, pode ser igual à DATABASE_URL)
DIRECT_URL="postgresql://usuario:senha@localhost:5432/rare_essence?schema=public"

# Autenticação do Administrador Único
ADMIN_EMAIL="admin@rareessence.com"
# Gere o hash com npm run admin:hash e a chave com node:crypto.randomBytes(32).
ADMIN_PASSWORD_HASH="scrypt:substitua_por_salt_hex_de_32_caracteres:substitua_por_hash_hex_de_128_caracteres"
ADMIN_SESSION_SECRET="substitua_por_chave_aleatoria_base64url_de_32_bytes"

# Gateway de Pagamento (Mercado Pago Sandbox)
MERCADO_PAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADO_PAGO_WEBHOOK_SECRET="webhook_secret_sandbox"

# Gateway de Frete (Melhor Envio Sandbox)
MELHOR_ENVIO_TOKEN="bearer_token_sandbox"
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_USER_AGENT="Rare Essence (contato@exemplo.com)"
CEP_ORIGEM="01001000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"